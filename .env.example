# --- Telegram bot (BotFather) ---
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
GROUP_CHAT_ID=
# Extra trusted Telegram user ids, comma-separated (besides admin)
ALLOWED_USER_IDS=

# --- MAX messenger (dev.max.ru) ---
MAX_BOT_TOKEN=
MAX_ADMIN_USER_ID=

# --- TG <-> MAX bridge (Telethon userbot, see BRIDGE-GUIDE.md) ---
# api_id / api_hash from https://my.telegram.org
BRIDGE_API_ID=
BRIDGE_API_HASH=
BRIDGE_SESSION_PATH=data/bridge.session
# Comma-separated TG group chat ids to forward into MAX
BRIDGE_GROUP_WHITELIST=

# --- Claude ---
CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_MODEL_DEEP=
# CLAUDE_MODEL_FAST=

# --- Todoist (optional) ---
TODOIST_API_TOKEN=
TODOIST_PROJECT_ID=

# --- Inbox / heartbeat personalization (optional, comma-separated) ---
SKIP_INBOX_GROUPS=
HEARTBEAT_VIP_KEYWORDS=

# --- Google Calendar tool (optional) ---
# GOOGLE_CREDS_FILE=/path/to/credentials.json
# CALENDAR_EXCLUDED=cal-id-1,cal-id-2
